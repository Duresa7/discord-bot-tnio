# Copy this file to .env and fill in your own values.
# Never commit .env.

# Discord
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# true = ping @everyone one time on each new weekly post
PING_EVERYONE=false
# Emoji around "ALL TIMES IN EST", for example <:tnio:123456789012345678>
SCHEDULE_EMOJI=

# Google Calendar > Settings > (the calendar) > Integrate calendar > Calendar ID
# "primary" = the main calendar of the signed-in account
GOOGLE_CALENDAR_ID=primary

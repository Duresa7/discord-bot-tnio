# Copy this file to .env and fill in your own values (the control panel does this for you).
# Never commit .env.

# Discord bot token (one bot for both servers)
DISCORD_TOKEN=

# Which server the bot posts to: test or real
DISCORD_SERVER=test

# Test server
TEST_CHANNEL_ID=
TEST_SCHEDULE_EMOJI=
TEST_PING_EVERYONE=false

# Real server
REAL_CHANNEL_ID=
REAL_SCHEDULE_EMOJI=
REAL_PING_EVERYONE=false

# Google Calendar > Settings > (the calendar) > Integrate calendar > Calendar ID
# "primary" = the main calendar of the signed-in account
GOOGLE_CALENDAR_ID=primary

# Footer contact: a name from the host list (empty = no contact line)
CONTACT_HOST=

# Weekly post of the next week (Eastern time). Default: sunday 21:00
POST_DAY=sunday
POST_TIME=21:00
